     * =========================================================
     */

    async function copyToClipboard(
        text
    ) {
        if (
            navigator
                .clipboard
                ?.writeText
        ) {
            try {
                await navigator
                    .clipboard
                    .writeText(
                        text
                    );

                return;
            } catch {
                // fallback
            }
        }

        const textarea =
            document.createElement(
                'textarea'
            );

        textarea.value =
            text;

        textarea.style.position =
            'fixed';

        textarea.style.left =
            '-9999px';

        textarea.style.top =
            '-9999px';

        document.body.appendChild(
            textarea
        );

        textarea.select();

        const success =
            document.execCommand(
                'copy'
            );

        textarea.remove();

        if (!success) {
            throw new Error(
                'Falha ao copiar.'
            );
        }
    }

    function showCopyState(
        button,
        text,
        className
    ) {
        button.classList.remove(
            'tm-success',
            'tm-error'
        );

        button.textContent =
            text;

        if (className) {
            button.classList.add(
                className
            );
        }

        setTimeout(
            () => {
                button.classList.remove(
                    'tm-success',
                    'tm-error'
                );

                button.textContent =
                    'Copiar Máscara';
            },
            1800
        );
    }

