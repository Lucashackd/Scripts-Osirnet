    /*
     * =========================================================
     * BOTÃO
     * =========================================================
     */

    function findSplitterContainer(
        input
    ) {
        let element =
            input;

        while (
            element &&
            element !==
                document.body
        ) {
            if (
                element
                    .classList
                    ?.contains(
                        'MuiFormControl-root'
                    ) &&
                element
                    .querySelector(
                        `#${CONFIG.splitterInputId}`
                    )
            ) {
                return element;
            }

            element =
                element.parentElement;
        }

        return (
            input.parentElement ||
            null
        );
    }

    function addSplitterButton() {
        if (
            document.getElementById(
                CONFIG.buttonId
            )
        ) {
            return;
        }

        const input =
            document.getElementById(
                CONFIG.splitterInputId
            );

        if (!input) {
            return;
        }

        const container =
            findSplitterContainer(
                input
            );

        if (!container) {
            return;
        }

        if (
            container
                .parentElement
                ?.classList
                .contains(
                    'tm-splitter-action-wrapper'
                )
        ) {
            return;
        }

        const wrapper =
            document.createElement(
                'div'
            );

        wrapper.className =
            'tm-splitter-action-wrapper';

        container
            .parentNode
            .insertBefore(
                wrapper,
                container
            );

        container.classList.add(
            'tm-splitter-original'
        );

        wrapper.appendChild(
            container
        );

        const button =
            document.createElement(
                'button'
            );

        button.id =
            CONFIG.buttonId;

        button.type =
            'button';

        button.title =
            'Caixa sem Registro / Inconsistência';

        button.setAttribute(
            'aria-label',
            'Caixa sem Registro / Inconsistência'
        );

        button.innerHTML =
            getWarningIcon();

        button.addEventListener(
            'click',
            (event) => {
                event.preventDefault();
                event.stopPropagation();

                openModal();
            }
        );

        wrapper.appendChild(
            button
        );
    }

    /*
     * =========================================================
     * EVENTOS
     * =========================================================
     */

    document.addEventListener(
        'keydown',
        (event) => {
            if (
                event.key ===
                    'Escape'
            ) {
                closeModal();
            }
        }
    );

    /*
     * =========================================================
     * OBSERVER
     * =========================================================
     */

    const observer =
        new MutationObserver(
            () => {
                if (
                    mutationScheduled
                ) {
                    return;
                }

                mutationScheduled =
                    true;

                requestAnimationFrame(
                    () => {
                        mutationScheduled =
                            false;

                        addSplitterButton();
                    }
                );
            }
        );

    /*
     * =========================================================
     * INIT
     * =========================================================
     */

    function init() {
        if (!document.body) {
            return;
        }

        injectStyles();

        addSplitterButton();

        observer.observe(
            document.body,
            {
                childList: true,
                subtree: true,
            }
        );
    }

    if (
        document.readyState ===
        'loading'
    ) {
        document.addEventListener(
            'DOMContentLoaded',
            init,
            {
                once: true,
            }
        );
    } else {
        init();
    }
})();
