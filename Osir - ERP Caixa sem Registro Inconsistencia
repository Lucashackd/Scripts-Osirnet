        );
    }

    /*
     * =========================================================
     * CARGA COMPLETA DOS DADOS
     * =========================================================
     */

    async function loadCustomerData(
        modal
    ) {
        let client =
            firstText(
                getVisibleClient(),
                getReactClient()
            );

        let responsible =
            firstText(
                getVisibleAttendant(),
                getReactResponsible()
            );

        /*
         * NOVO:
         *
         * A etiqueta COMPLETA do grid
         * é a fonte prioritária.
         */
        let fullTag =
            firstText(
                getFullTagFromGrid(),
                buildFullTagFromReact()
            );

        let address =
            getAddressFromReact();

        /*
         * Dados já disponíveis
         * antes da API.
         */
        if (client) {
            setModalInputValue(
                modal,
                'tm-mask-installed-client',
                client
            );

            setModalInputValueIfEmpty(
                modal,
                'tm-mask-original-client',
                client
            );
        }

        if (responsible) {
            setModalInputValueIfEmpty(
                modal,
                'tm-mask-responsible',
                responsible
            );
        }

        if (fullTag) {
            setModalInputValueIfEmpty(
                modal,
                'tm-mask-tag',
                fullTag
            );
        }

        if (address) {
            setModalInputValue(
                modal,
                'tm-mask-box-address',
                address
            );
        }

        /*
         * Consulta APIs.
         */
        const [
            information,
            reports,
        ] =
            await Promise.all([
                getSolicitationInformation()
                    .catch(
                        () => null
                    ),

                getAssignmentReports()
                    .catch(
                        () => null
                    ),
            ]);

        /*
         * Cliente.
         */
        client =
            firstText(
                getClientFromInformation(
                    information
                ),

                client
            );

        /*
         * Responsável.
         */
        responsible =
            firstText(
                getVisibleAttendant(),

                getResponsibleFromReports(
                    reports
                ),

                responsible
            );

        /*
         * Etiqueta completa.
         *
         * Ordem:
         *
         * 1. Grid ETIQUETA completo
         * 2. API
         * 3. React
         * 4. valor já encontrado
         */
        fullTag =
            firstText(
                getFullTagFromGrid(),

                buildFullTagFromInformation(
                    information
                ),

                buildFullTagFromReact(),

                fullTag
            );

        /*
         * Endereço.
         */
        address =
            firstText(
                getAddressFromInformation(
                    information
                ),

                address
            );

        /*
         * Protocolo.
         */
        const protocol =
            normalizeNumericId(
                information
                    ?.id
            );

        if (protocol) {
            setModalInputValue(
                modal,
                'tm-mask-os-protocol',
                protocol
            );

            setModalInputValueIfEmpty(
                modal,
                'tm-mask-original-protocol',
                protocol
            );
        }

        if (client) {
            setModalInputValue(
                modal,
                'tm-mask-installed-client',
                client
            );

            setModalInputValueIfEmpty(
                modal,
                'tm-mask-original-client',
                client
            );
        }

        if (responsible) {
            setModalInputValueIfEmpty(
                modal,
                'tm-mask-responsible',
                responsible
            );
        }

        if (fullTag) {
            setModalInputValueIfEmpty(
                modal,
                'tm-mask-tag',
                fullTag
            );
        }

        if (address) {
            setModalInputValue(
                modal,
                'tm-mask-box-address',
                address
            );
        }
    }

