     * =========================================================
     */

    function getPanelFieldValue(
        labelText
    ) {
        const expected =
            normalizeLabel(
                labelText
            );

        for (
            const paragraph
            of document.querySelectorAll(
                'p'
            )
        ) {
            if (
                normalizeLabel(
                    paragraph.textContent
                ) !== expected
            ) {
                continue;
            }

            const parent =
                paragraph.parentElement;

            if (!parent) {
                continue;
            }

            const paragraphs =
                Array.from(
                    parent.children
                ).filter(
                    (element) =>
                        element.tagName ===
                        'P'
                );

            const index =
                paragraphs.indexOf(
                    paragraph
                );

            for (
                let i =
                    index + 1;
                i <
                    paragraphs.length;
                i++
            ) {
                const value =
                    normalizeText(
                        paragraphs[
                            i
                        ].textContent
                    );

                if (value) {
                    return value;
                }
            }
        }

        return '';
    }

    /*
     * Lê grids Material UI no padrão:
     *
     * <div container>
     *     <div item>
     *         <p>ETIQUETA</p>
     *     </div>
     *
     *     <div item>
     *         <p>VALOR COMPLETO</p>
     *     </div>
     * </div>
     */
    function getGridFieldValue(
        labelText
    ) {
        const expected =
            normalizeLabel(
                labelText
            );

        for (
            const paragraph
            of document.querySelectorAll(
                'p'
            )
        ) {
            if (
                normalizeLabel(
                    paragraph.textContent
                ) !== expected
            ) {
                continue;
            }

            const labelColumn =
                paragraph.closest(
                    '.MuiGrid-item'
                ) ||
                paragraph.parentElement;

            if (!labelColumn) {
                continue;
            }

            const row =
                labelColumn.parentElement;

            if (!row) {
                continue;
            }

            const columns =
                Array.from(
                    row.children
                );

            const labelIndex =
                columns.indexOf(
                    labelColumn
                );

            if (
                labelIndex < 0
            ) {
                continue;
            }

            /*
             * Procura nas colunas
             * posteriores ao rótulo.
             */
            for (
                let i =
                    labelIndex + 1;
                i <
                    columns.length;
                i++
            ) {
                const valueParagraphs =
                    Array.from(
                        columns[
                            i
                        ].querySelectorAll(
                            'p'
                        )
                    );

                for (
                    const valueParagraph
                    of valueParagraphs
                ) {
                    const value =
                        normalizeText(
                            valueParagraph
                                .textContent
                        );

                    if (
                        value &&
                        normalizeLabel(
                            value
                        ) !== expected
                    ) {
                        return value;
                    }
                }
            }
        }

        return '';
    }

