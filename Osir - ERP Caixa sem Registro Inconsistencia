                ?.assignment
                ?.contractServiceTag
                ?.title
        );
    }

    /*
     * =========================================================
     * ENDEREÇO
     * =========================================================
     */

    function getDirectAddressFromInformation(
        information
    ) {
        return firstText(
            information
                ?.address,

            information
                ?.address
                ?.description,

            information
                ?.address
                ?.fullAddress,

            information
                ?.client
                ?.address,

            information
                ?.client
                ?.address
                ?.description,

            information
                ?.client
                ?.address
                ?.fullAddress,

            information
                ?.customer
                ?.address,

            information
                ?.customer
                ?.address
                ?.description,

            information
                ?.customer
                ?.address
                ?.fullAddress,

            information
                ?.contractServiceTag
                ?.address,

            information
                ?.contractServiceTag
                ?.address
                ?.description,

            information
                ?.contractServiceTag
                ?.fullAddress
        );
    }

    function extractAddressFromServiceTitle(
        fullTitle,
        service
    ) {
        const title =
            normalizeText(
                fullTitle
            );

        const serviceText =
            normalizeText(
                service
            );

        if (!title) {
            return '';
        }

        if (
            serviceText &&
            title
                .toLowerCase()
                .startsWith(
                    serviceText
                        .toLowerCase()
                )
        ) {
            return normalizeText(
                title.slice(
                    serviceText.length
                )
            );
        }

        const addressStart =
            title.search(
                /\b(Rua|Avenida|Av\.?|Travessa|Tv\.?|Estrada|Rodovia|R\.|Praça|Alameda|Beco)\b/i
            );

        if (
            addressStart >= 0
        ) {
            return normalizeText(
                title.slice(
                    addressStart
                )
            );
        }

        return '';
    }

    function getAddressFromInformation(
        information
    ) {
        const direct =
            getDirectAddressFromInformation(
                information
            );

        if (
            direct &&
            typeof direct ===
                'string'
        ) {
            return direct;
        }

        const title =
            getServiceTitleFromInformation(
                information
            );

        return firstText(
            extractAddressFromServiceTitle(
                title,
                getVisibleService()
            ),

            extractAddressFromServiceTitle(
                title,
                information
                    ?.service
                    ?.title
            ),

            extractAddressFromServiceTitle(
                title,
                information
                    ?.service
                    ?.name
            )
        );
    }

    function getAddressFromReact() {
        return extractAddressFromServiceTitle(
            getReactServiceTitle(),
            getVisibleService()
        );
    }

    /*
     * =========================================================
     * RESPONSÁVEL
     * =========================================================
     */

    function getResponsibleFromReports(
        reports
    ) {
        if (!reports) {
            return '';
        }

        const items =
            Array.isArray(
                reports
            )
                ? reports
                : [
                    reports,
                ];

        const candidates = [];

        for (
            const item
            of items
        ) {
            candidates.push(
                item
                    ?.attendant
                    ?.name,

                item
                    ?.responsible
                    ?.name,

                item
                    ?.responsibleName,

                item
                    ?.attendantName,

                item
                    ?.user
                    ?.name
            );

            if (
                typeof item
                    ?.responsible ===
                    'string'
            ) {
                candidates.push(
                    item.responsible
                );
            }

            if (
                typeof item
                    ?.attendant ===
                    'string'
            ) {
                candidates.push(
                    item.attendant
                );
            }
        }

        return firstText(
            ...candidates
        );
    }

    /*
     * =========================================================
     * ETIQUETA COMPLETA - FALLBACK API
     * =========================================================
     */

    function buildFullTagFromInformation(
        information
    ) {
        const tagCode =
            getTagCodeFromInformation(
                information
            );

        const title =
            getServiceTitleFromInformation(
                information
            );

        if (
            tagCode &&
            title
        ) {
            return normalizeText(
                `${tagCode} - ${title}`
            );
        }

        return firstText(
            title,
            tagCode
        );
    }

    function buildFullTagFromReact() {
        const tagCode =
            getReactTagCode();

        const title =
            getReactServiceTitle();

        if (
            tagCode &&
            title
        ) {
            return normalizeText(
                `${tagCode} - ${title}`
            );
        }

        return firstText(
            title,
            tagCode
        );
    }

