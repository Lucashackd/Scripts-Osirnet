        const json =
            await apiGet(
                `/api/v1/ServiceDesk/AssignmentIncidents/GetSolicitationInformations?assignmentId=${
                    encodeURIComponent(
                        assignmentId
                    )
                }`
            );

        return (
            json?.response ??
            json ??
            null
        );
    }

