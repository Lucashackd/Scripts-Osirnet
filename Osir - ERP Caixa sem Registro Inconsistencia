    function normalizeText(value) {
        return String(value ?? '')
            .replace(/\s+/g, ' ')
            .trim();
    }

    function normalizeLabel(value) {
        return normalizeText(value)
            .toUpperCase();
    }

    function normalizeNumericId(value) {
        const text =
            normalizeText(value);

        return /^\d+$/.test(text)
            ? text
            : '';
    }

    function escapeHtmlAttribute(value) {
        return String(value ?? '')
            .replaceAll('&', '&amp;')
            .replaceAll('"', '&quot;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;');
    }

    function firstText(...values) {
        return (
            values
                .map(normalizeText)
                .find(Boolean) ||
            ''
        );
    }

    function getErpInputValue(id) {
        return (
            document
                .getElementById(id)
                ?.value
                ?.trim() ||
            ''
        );
    }

    /*
     * Remove:
     *
     * Slot XX Porta XX
     *
     * Exemplo:
     *
     * Fibra BGE Slot 03 Porta 11
     * ->
     * Fibra BGE
     */
    function normalizeOltValue(value) {
        return normalizeText(
            value
        )
            .replace(
                /\s+Slot\s+\d+\s+Porta\s+\d+\s*$/i,
                ''
            )
            .trim();
    }

