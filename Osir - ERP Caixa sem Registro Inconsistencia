    function createMaskRow(
        id,
        label,
        value = '',
        type = 'text'
    ) {
        const numeric =
            type === 'number'
                ? `
                    min="0"
                    step="1"
                    inputmode="numeric"
                `
                : '';

        return `
            <div class="tm-mask-row">

                <label
                    class="tm-mask-row-label"
                    for="${id}"
                >
                    ${label}
                </label>

                <input
                    id="${id}"
                    class="tm-mask-input"
                    type="${type}"
                    value="${escapeHtmlAttribute(value)}"
                    autocomplete="off"
                    ${numeric}
                >

            </div>
        `;
    }

    function configureIntegerInputs(
        modal
    ) {
        const ids = [
            'tm-mask-os-protocol',
            'tm-mask-client-port',
            'tm-mask-slot-olt',
            'tm-mask-port-olt',
            'tm-mask-original-protocol',
        ];

        for (
            const id
            of ids
        ) {
            const input =
                modal.querySelector(
                    `#${id}`
                );

            if (!input) {
                continue;
            }

            input.addEventListener(
                'keydown',
                (event) => {
                    if (
                        [
                            'e',
                            'E',
                            '+',
                            '-',
                            '.',
                            ',',
                        ].includes(
                            event.key
                        )
                    ) {
                        event.preventDefault();
                    }
                }
            );

            input.addEventListener(
                'input',
                () => {
                    input.value =
                        input.value.replace(
                            /\D/g,
                            ''
                        );
                }
            );
        }
    }

