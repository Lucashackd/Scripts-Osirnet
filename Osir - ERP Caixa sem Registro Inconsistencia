    function getOsProtocolValue() {
        return normalizeNumericId(
            findProtocolLink()
                ?.textContent
        );
    }

    function getReactFiber() {
        const link =
            findProtocolLink();

        if (!link) {
            return null;
        }

        const key =
            Object.keys(
                link
            ).find(
                (item) =>
                    item.startsWith(
                        '__reactFiber$'
                    )
            );

        return key
            ? link[key]
            : null;
    }

    function getReactContext() {
        let fiber =
            getReactFiber();

        const contexts = [];

        let level = 0;

        while (
            fiber &&
            level < 80
        ) {
            if (
                fiber.memoizedProps &&
                typeof fiber
                    .memoizedProps ===
                    'object'
            ) {
                contexts.push(
                    fiber.memoizedProps
                );
            }

            if (
                fiber.pendingProps &&
                typeof fiber
                    .pendingProps ===
                    'object'
            ) {
                contexts.push(
                    fiber.pendingProps
                );
            }

            fiber =
                fiber.return;

            level++;
        }

        return contexts;
    }

    function getAssignmentIdFromReact() {
        for (
            const props
            of getReactContext()
        ) {
            const candidates = [
                props
                    ?.solicitationInformationStore
                    ?.formControls
                    ?.id
                    ?.value,

                props
                    ?.tabsStore
                    ?.currentTab
                    ?.data
                    ?.assignmentId,

                props
                    ?.tabsStore
                    ?.currentTab
                    ?.data
                    ?.assignment
                    ?.id,
            ];

            for (
                const candidate
                of candidates
            ) {
                const id =
                    normalizeNumericId(
                        candidate
                    );

                if (id) {
                    return id;
                }
            }
        }

        return '';
    }

