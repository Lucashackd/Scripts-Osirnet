            const container =
                span.parentElement;

            if (!container) {
                continue;
            }

            const children =
                Array.from(
                    container.children
                );

            const index =
                children.indexOf(
                    span
                );

            for (
                let i =
                    index + 1;
                i <
                    children.length;
                i++
            ) {
                const value =
                    normalizeText(
                        children[
                            i
                        ].textContent
                    );

                if (
                    value &&
                    normalizeLabel(
                        value
                    ) !== expected
                ) {
                    return value;
                }
            }
        }

        return '';
    }

