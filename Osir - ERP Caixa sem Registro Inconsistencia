    function setModalInputValue(
        modal,
        id,
        value
    ) {
        const input =
            modal.querySelector(
                `#${id}`
            );

        const text =
            normalizeText(
                value
            );

        if (
            input &&
            text
        ) {
            input.value =
                text;
        }
    }

    function setModalInputValueIfEmpty(
        modal,
        id,
        value
    ) {
        const input =
            modal.querySelector(
                `#${id}`
            );

        const text =
            normalizeText(
                value
            );

        if (
            !input ||
            !text ||
            input.value.trim()
        ) {
            return;
        }

        input.value =
            text;
    }

    function getModalInputValue(
        modal,
        id
    ) {
        return (
            modal
                .querySelector(
                    `#${id}`
                )
                ?.value
                ?.trim() ||
            ''
        );
    }

