(function() {
    'use strict';

    const VERSAO = '3.0.0';
    const HOST = window.location.hostname;

    const isERP = HOST.includes('erp.osirnet.com.br');
    // Sistema de cadastro: MVNO TIP Brasil (clone) ou o Tatelecom original
    const isTatelecom = HOST.includes('mvno.tipbrasil.com.br') || HOST.includes('tatelecom.com.br');

    // Acesso às variáveis da página (Livewire, jQuery) a partir do sandbox do userscript
    const pageWin = (typeof unsafeWindow !== 'undefined') ? unsafeWindow : window;

    // Configuração de delays
    const CONFIG = {
        DELAY_INICIAL: 300,
        DELAY_CAMPO: 300,
        DELAY_CEP: 500,
        DELAY_ENDERECO: 200,
        DELAY_TELEFONE: 400,
        DELAY_FINAL: 800
    };

    // ============================================
    // LOG APENAS NO CONSOLE
    // ============================================
    function log(mensagem, tipo = 'info') {
        const emojis = { success: '✅', error: '❌', warning: '⚠️', info: 'ℹ️' };
        console.log(`${emojis[tipo] || 'ℹ️'} ${mensagem}`);
    }

    // ============================================
    // FEEDBACK VISUAL NO BOTÃO
    // ============================================
    function feedbackBotao(btn, sucesso, msg) {
        if (!btn) return;
        const originalText = btn.textContent;
        const originalBg = btn.style.backgroundColor;

        btn.textContent = (sucesso ? '✅ ' : '❌ ') + msg;
        btn.style.backgroundColor = sucesso ? '#2e7d32' : '#c62828';
        btn.style.color = 'white';
        btn.disabled = true;

        setTimeout(() => {
            btn.textContent = originalText;
            btn.style.backgroundColor = originalBg || '';
            btn.style.color = '';
            btn.disabled = false;
        }, 1500);
    }

    // ============================================
    // VERIFICAR SE É MODAL DE INFORMAÇÕES DO CLIENTE
    // ============================================
    function isModalInformacoesCliente() {
        const modal = document.querySelector('.MuiDialog-container');
        if (!modal) return false;

        const titulo = modal.querySelector('.MuiTypography-root[class*="MuiTypography-h6"]');
        return titulo && titulo.textContent.includes('Informações -');
    }

    // ============================================
    // EXTRAIR DADOS DO ERP
    // ============================================
    function extrairDadosERP() {
        const modal = document.querySelector('.MuiDialog-container');
        if (!modal) {
            log('Modal não encontrado!', 'error');
            return null;
        }

        try {
            const dados = {
                nome: '',
                documento: '',
                endereco: '',
                cep: '',
                dataNascimento: '',
                email: '',
                celular: '',
                logradouro: '',
                numero: '',
                bairro: '',
                cidade: '',
                uf: ''
            };

            // Captura nome do título
            const titulo = modal.querySelector('.MuiTypography-root[class*="MuiTypography-h6"]');
            if (titulo) {
                const match = titulo.textContent.match(/Informações - (.+)/);
                dados.nome = match ? match[1].trim() : titulo.textContent.replace('Informações - ', '').trim();
            }

            // Função auxiliar para buscar valor por label
            function getValueByLabel(labelText) {
                const labels = modal.querySelectorAll('[class*="MuiTypography-subtitle1"]');
                for (let label of labels) {
                    if (label.textContent.trim().includes(labelText)) {
                        const parent = label.closest('.MuiGrid-root');
                        if (parent) {
                            const value = parent.querySelector('[class*="MuiTypography-body1"]');
                            if (value) return value.textContent.trim();
                        }
                        break;
                    }
                }
                return '';
            }

            // Função para extrair endereço completo
            function getEnderecoCompleto() {
                const labels = modal.querySelectorAll('[class*="MuiTypography-subtitle1"]');
                for (let label of labels) {
                    if (label.textContent.trim().includes('Endereço:')) {
                        const parent = label.closest('.MuiGrid-root');
                        if (parent) {
                            const div = parent.querySelector('[class*="MuiTypography-body1"]');
                            if (div) {
                                const spans = div.querySelectorAll('span');
                                if (spans.length >= 2) {
                                    return {
                                        endereco: spans[0]?.textContent.trim() || '',
                                        cep: spans[1]?.textContent.trim() || ''
                                    };
                                }
                                const texto = div.textContent.trim();
                                const cepMatch = texto.match(/\d{5}-\d{3}/);
                                return {
                                    endereco: texto.replace(/\d{5}-\d{3}/, '').trim(),
                                    cep: cepMatch ? cepMatch[0] : ''
                                };
                            }
                        }
                        break;
                    }
                }
                return { endereco: '', cep: '' };
            }

            dados.documento = getValueByLabel('Nº do documento');
            dados.dataNascimento = getValueByLabel('Data de Nascimento:');
            dados.email = getValueByLabel('Email:');
            dados.celular = getValueByLabel('Celular:');

            const endInfo = getEnderecoCompleto();
            dados.endereco = endInfo.endereco;
            dados.cep = endInfo.cep;

            if (dados.endereco) {
                const partes = fatiarEndereco(dados.endereco);
                Object.assign(dados, partes);
            }

            log(`Dados capturados: ${dados.nome}`, 'success');
            return dados;
        } catch (error) {
            console.error('Erro na extração:', error);
            log('Erro ao extrair dados. Veja o console (F12)', 'error');
            return null;
        }
    }

    // ============================================
    // FATIAR ENDEREÇO
    // ============================================
    function fatiarEndereco(enderecoCompleto) {
        const resultado = { logradouro: '', numero: '', bairro: '', cidade: '', uf: '' };
        if (!enderecoCompleto) return resultado;

        try {
            const semCep = enderecoCompleto.replace(/\d{5}-\d{3}/, '').trim();
            const partes = semCep.split(',').map(p => p.trim()).filter(p => p);

            if (partes.length >= 1) {
                const primeira = partes[0];
                const numMatch = primeira.match(/\s(\d+)$/);
                if (numMatch) {
                    resultado.numero = numMatch[1];
                    resultado.logradouro = primeira.replace(/\s\d+$/, '').trim();
                } else {
                    const n = primeira.match(/\d+/);
                    if (n) {
                        resultado.numero = n[0];
                        resultado.logradouro = primeira.replace(n[0], '').trim();
                    } else {
                        resultado.logradouro = primeira;
                    }
                }
            }

            if (partes.length >= 2) {
                const segunda = partes[1].trim();
                const bairro = segunda.replace(/\s*-\s*[A-Za-zçãõáéíóúâêîôûàèìòù\s]+\s*[A-Z]{2}$/, '')
                                     .replace(/\s*-\s*[A-Za-z\s]+$/, '')
                                     .trim();
                resultado.bairro = bairro || segunda;
            }

            if (partes.length >= 3) {
                const cidadeUf = partes[2].trim();
                const ufMatch = cidadeUf.match(/\b([A-Z]{2})$/);
                if (ufMatch) {
                    resultado.uf = ufMatch[1];
                    resultado.cidade = cidadeUf.replace(/\s*[A-Z]{2}$/, '').trim();
                } else {
                    resultado.cidade = cidadeUf;
                }
            } else if (partes.length === 2) {
                const segunda = partes[1].trim();
                const ufMatch = segunda.match(/\b([A-Z]{2})$/);
                if (ufMatch) {
                    resultado.uf = ufMatch[1];
                    const cidadeBairro = segunda.replace(/\s*[A-Z]{2}$/, '').trim();
                    const bc = cidadeBairro.split('-').map(p => p.trim());
                    if (bc.length >= 2) {
                        resultado.bairro = bc[0];
                        resultado.cidade = bc[1];
                    } else {
                        resultado.cidade = cidadeBairro;
                    }
                }
            }

            if (resultado.bairro) {
                resultado.bairro = resultado.bairro
                    .replace(/\s*-\s*[A-Za-zçãõáéíóúâêîôûàèìòù\s]+\s*$/, '')
                    .replace(/\s*[A-Z]{2}$/, '')
                    .trim();
            }

        } catch (error) {
            console.error('Erro ao fatiar endereço:', error);
        }

        return resultado;
    }

    // ============================================
    // COPIAR DADOS
    // ============================================
    function copiarDadosCliente() {
        const btn = document.getElementById('btn-copiar-erp');
        const dados = extrairDadosERP();

        if (dados && dados.nome) {
            GM_setValue('dados_cliente_erp', JSON.stringify(dados));
            feedbackBotao(btn, true, 'Copiado!');
            log('Dados salvos!', 'success');
        } else {
            feedbackBotao(btn, false, 'Falhou!');
        }
    }

    // ============================================
    // HELPERS
    // ============================================
    const esperar = ms => new Promise(resolve => setTimeout(resolve, ms));

    // Retorna o primeiro elemento que casar com algum dos seletores
    function primeiro(...seletores) {
        for (const s of seletores) {
            try {
                const el = document.querySelector(s);
                if (el) return el;
            } catch (e) { /* seletor inválido: ignora */ }
        }
        return null;
    }

    // Campo ligado ao Livewire v2: wire:model, wire:model.defer, .lazy ou .live
    function campoWire(modelo) {
        return primeiro(
            `[wire\\:model="${modelo}"]`,
            `[wire\\:model\\.defer="${modelo}"]`,
            `[wire\\:model\\.lazy="${modelo}"]`,
            `[wire\\:model\\.live="${modelo}"]`
        );
    }

    async function esperarElemento(buscar, timeout = 3000, intervalo = 100) {
        const limite = Date.now() + timeout;
        while (Date.now() < limite) {
            const el = buscar();
            if (el) return el;
            await esperar(intervalo);
        }
        return null;
    }

    function lerDadosSalvos() {
        try {
            return JSON.parse(GM_getValue('dados_cliente_erp') || '{}');
        } catch (e) {
            return {};
        }
    }

    function clicarAba(href) {
        const aba = document.querySelector(`a[href="${href}"]`);
        if (aba) aba.click();
        return !!aba;
    }

    // ============================================
    // FORÇAR INPUT NO LIVEWIRE
    // ============================================
    function forcarInputLivewire(elemento, valor, campoNome) {
        if (!elemento) return false;

        try {
            let valorFinal = valor;
            const nomeCampo = (campoNome || '').toLowerCase();
            const digitos = String(valor).replace(/\D/g, '');

            if (nomeCampo.includes('cpf')) {
                if (digitos.length === 11) {
                    valorFinal = digitos.replace(/(\d{3})(\d{3})(\d{3})(\d{2})/, '$1.$2.$3-$4');
                } else if (digitos.length === 14) {
                    valorFinal = digitos.replace(/(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})/, '$1.$2.$3/$4-$5');
                }
            }

            if (nomeCampo.includes('telefone') && String(valor).length === 11) {
                valorFinal = String(valor).replace(/(\d{2})(\d{5})(\d{4})/, '($1)$2-$3');
            }

            elemento.focus();
            elemento.value = valorFinal;

            ['input', 'change', 'blur'].forEach(tipo => {
                elemento.dispatchEvent(new Event(tipo, { bubbles: true, cancelable: true }));
            });

            const component = elemento.closest('[wire\\:id]');
            if (component && pageWin.Livewire) {
                try {
                    const wireId = component.getAttribute('wire:id');
                    const lw = pageWin.Livewire.find(wireId);
                    if (lw) {
                        const modelName = elemento.getAttribute('wire:model') ||
                                          elemento.getAttribute('wire:model.defer') ||
                                          elemento.getAttribute('wire:model.lazy') ||
                                          elemento.getAttribute('wire:model.live');
                        if (modelName) {
                            lw.set(modelName, valorFinal, true);
                        }
                    }
                } catch (e) {
                    // Fallback: os eventos DOM acima já alimentam o Livewire
                }
            }

            setTimeout(() => {
                if (elemento.value !== valorFinal) {
                    elemento.value = valorFinal;
                    elemento.dispatchEvent(new Event('input', { bubbles: true }));
                }
            }, 100);

            return true;
        } catch (error) {
            console.error(`Erro ao preencher ${campoNome}:`, error);
            return false;
        }
    }

    // Seleciona num <select> a primeira opção aceita pelo predicado (recebe o texto em minúsculas)
    function selecionarOpcao(select, aceita, nome) {
        if (!select) return false;
        const opt = Array.from(select.options).find(o => aceita(o.textContent.trim().toLowerCase(), o));
        if (!opt) return false;
        forcarInputLivewire(select, opt.value, nome);
        return true;
    }

    // Preenche tanto <input> quanto <select> (no novo sistema cidade/UF são inputs de texto)
    function preencherCampoOuSelect(el, valor, nome) {
        if (!el || !valor) return false;
        if (el.tagName === 'SELECT') {
            const alvo = String(valor).trim().toLowerCase();
            return selecionarOpcao(el, t => t === alvo, nome) ||
                   selecionarOpcao(el, t => t.includes(alvo), nome);
        }
        return forcarInputLivewire(el, valor, nome);
    }

    // ============================================
    // PREENCHER CPF (etapa 1: busca)
    // ============================================
    function preencherCpf() {
        const btn = document.getElementById('btn-preenche-cpf');
        const dados = lerDadosSalvos();

        if (!dados.documento) {
            feedbackBotao(btn, false, 'Sem CPF');
            log('Capture os dados no ERP primeiro!', 'error');
            return;
        }

        const cpfInput = primeiro(
            'input#input_cpf',
            'input[wire\\:model\\.defer="input_cpf"]',
            'input[wire\\:model*="cpf"]',
            'input[name*="cpf"]',
            'input[type="text"][placeholder*="CPF"]'
        );

        if (!cpfInput) {
            feedbackBotao(btn, false, 'Campo não encontrado');
            return;
        }

        // Ajusta Pessoa Física / Jurídica conforme o tamanho do documento
        const digitos = dados.documento.replace(/\D/g, '');
        const tipoPessoa = primeiro('#input_tipo_pessoa');
        if (tipoPessoa) {
            const alvo = digitos.length > 11 ? 'j' : 'f';
            if (tipoPessoa.value !== alvo) {
                tipoPessoa.value = alvo;
                ['input', 'change'].forEach(t => tipoPessoa.dispatchEvent(new Event(t, { bubbles: true })));
                try {
                    // O select usa select2: precisa avisar o jQuery da página também
                    if (pageWin.jQuery) pageWin.jQuery(tipoPessoa).val(alvo).trigger('change');
                } catch (e) { /* sem jQuery: segue só com o evento nativo */ }
            }
        }

        setTimeout(() => {
            forcarInputLivewire(cpfInput, dados.documento, 'CPF');
            feedbackBotao(btn, true, 'CPF Colado!');
            log(`CPF ${dados.documento} preenchido`, 'success');
        }, 150);
    }

    // ============================================
    // PREENCHER TUDO AUTOMÁTICO (etapa 2: salva dados)
    // ============================================
    async function preencherTudoAutomatico() {
        const btn = document.getElementById('btn-auto-tudo');
        if (btn && btn.disabled) return;

        const dados = lerDadosSalvos();

        if (!dados.nome) {
            feedbackBotao(btn, false, 'Sem dados');
            log('Capture os dados no ERP primeiro!', 'error');
            return;
        }

        log('Iniciando preenchimento...', 'info');
        if (btn) btn.disabled = true;
        let ok = true;

        try {
            // 1) Dados pessoais
            const pessoais = [
                { nome: 'Nome', valor: dados.nome,
                  seletores: ['#input_nome', '[wire\\:model\\.defer="input_name"]'] },
                { nome: 'Data Nasc.', valor: dados.dataNascimento,
                  seletores: ['#input_dt_nascimento', '[wire\\:model\\.defer="input_dt_nascimento"]'] },
                { nome: 'Email', valor: dados.email,
                  seletores: ['#input_email', '[wire\\:model\\.defer="input_email"]'] },
                { nome: 'Nome da Mãe', valor: 'XXXX',
                  seletores: ['#input_nome_mae', '[wire\\:model\\.defer="input_nome_mae"]'] }
            ];

            for (const campo of pessoais) {
                if (!campo.valor) continue;
                const el = primeiro(...campo.seletores);
                if (el) forcarInputLivewire(el, campo.valor, campo.nome);
                else log(`Campo "${campo.nome}" não encontrado`, 'warning');
                await esperar(CONFIG.DELAY_CAMPO);
            }

            // 2) Telefone
            clicarAba('#primaryhome');
            await esperar(CONFIG.DELAY_TELEFONE);

            if (dados.celular) {
                let telInput = campoWire('telefones.0.numero');
                if (!telInput) {
                    // Nenhuma linha de telefone ainda: clica em "Novo"
                    const novo = primeiro('button[wire\\:click="add_tel"]');
                    if (novo) {
                        novo.click();
                        telInput = await esperarElemento(() => campoWire('telefones.0.numero'));
                    }
                }

                if (telInput) {
                    let telLimpo = dados.celular.replace(/\D/g, '');
                    if (telLimpo.length > 11 && telLimpo.startsWith('55')) telLimpo = telLimpo.slice(2);
                    forcarInputLivewire(telInput, telLimpo, 'Telefone');
                    await esperar(CONFIG.DELAY_TELEFONE);

                    selecionarOpcao(
                        campoWire('telefones.0.tipo'),
                        t => t.includes('celular') || t.includes('whatsapp'),
                        'Tipo'
                    );
                } else {
                    log('Campo de telefone não encontrado', 'warning');
                }
            }

            // 3) Endereço
            if (dados.cep) {
                await esperar(CONFIG.DELAY_CEP);
                clicarAba('#primaryprofile');
                await esperar(CONFIG.DELAY_ENDERECO);
                await executarFluxoEndereco(dados, 0);
            }

            await esperar(CONFIG.DELAY_FINAL);
        } catch (error) {
            ok = false;
            console.error('Erro no preenchimento:', error);
            log('Erro durante o preenchimento. Veja o console (F12)', 'error');
        } finally {
            // O Livewire pode ter recriado o botão durante o preenchimento
            const btnAtual = document.getElementById('btn-auto-tudo') || btn;
            if (btnAtual) {
                btnAtual.disabled = false;
                feedbackBotao(btnAtual, ok, ok ? 'Pronto!' : 'Erro');
            }
            if (ok) log('Preenchimento concluído!', 'success');
        }
    }

    // ============================================
    // FLUXO ENDEREÇO
    // ============================================
    async function executarFluxoEndereco(dados, index) {
        const base = `enderecos.${index}`;
        let cepInput = campoWire(`${base}.cep`) || primeiro(`#cep_${index}`);

        if (!cepInput) {
            // Nenhum endereço ainda: clica em "Novo"
            const novo = primeiro('button[wire\\:click="add_end"]');
            if (novo) {
                novo.click();
                cepInput = await esperarElemento(() => campoWire(`${base}.cep`));
            }
        }

        if (!cepInput) {
            log('Campo de CEP não encontrado', 'warning');
            return;
        }

        forcarInputLivewire(cepInput, dados.cep.replace(/\D/g, ''), 'CEP');
        await esperar(CONFIG.DELAY_CEP);

        const btnBusca = primeiro(
            `button[wire\\:click="busca_cep(${index})"]`,
            'button[wire\\:click*="busca_cep"]'
        );
        if (btnBusca) btnBusca.click();
        else log('Botão de busca de CEP não encontrado', 'warning');

        // Aguarda a consulta de CEP do sistema antes de aplicar os dados do ERP por cima
        await esperar(500);

        for (const chave of ['logradouro', 'numero', 'bairro', 'cidade', 'uf']) {
            if (dados[chave]) {
                // Refaz a busca a cada campo: o Livewire re-renderiza após a consulta de CEP
                preencherCampoOuSelect(campoWire(`${base}.${chave}`), dados[chave], chave);
            }
            await esperar(200);
        }

        selecionarOpcao(campoWire(`${base}.tipo`), t => t.includes('residencial'), 'Tipo');
    }

    // ============================================
    // FUNÇÕES DA MÁSCARA DE PORTABILIDADE
    // ============================================
    // Rótulos procurados na página (comparação sem acento/maiúscula). Ajuste aqui se o novo sistema usar outros nomes.
    const ROTULOS = {
        nome: ['Nome', 'Nome Completo', 'Cliente', 'Assinante'],
        cpf: ['CPF', 'CPF/CNPJ', 'Documento'],
        nascimento: ['Data Nascimento', 'Data de Nascimento', 'Nascimento'],
        email: ['Email', 'E-mail'],
        telefone: ['Telefone', 'Telefone Provisório', 'Número Provisório', 'Nº Telefone Provisório', 'Número da Linha', 'Linha', 'MSISDN'],
        iccid: ['ICCID', 'SimCard', 'SIM Card', 'Chip'],
        plano: ['Plano'],
        dataPortabilidade: ['Data Prevista', 'Data Prevista da Portabilidade', 'Data da Portabilidade'],
        numeroPortado: ['Número Portado', 'Número a Portar', 'Telefone Portado'],
        statusPortabilidade: ['Status']
    };

    function normalizarTexto(t) {
        return String(t || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '')
            .replace(/\s+/g, ' ').trim().toLowerCase();
    }

    // Texto visível da página em linhas (ignora a janela da máscara, se estiver aberta)
    function linhasDaPagina() {
        const overlay = document.getElementById('janela-mascara-portabilidade');
        const displayAnterior = overlay ? overlay.style.display : '';
        if (overlay) overlay.style.display = 'none';
        const texto = document.body ? document.body.innerText : '';
        if (overlay) overlay.style.display = displayAnterior;
        return texto.split(/[\n\t]+/).map(l => l.trim()).filter(Boolean);
    }

    // Acha "Rótulo: valor" (mesma linha) ou "Rótulo" / "Rótulo:" com o valor na linha seguinte
    function acharTodosPorRotulo(linhas, rotulos) {
        const alvos = rotulos.map(normalizarTexto);
        const achados = [];
        for (let i = 0; i < linhas.length; i++) {
            const linha = linhas[i];
            const idx = linha.indexOf(':');
            const nomeLinha = normalizarTexto(idx >= 0 ? linha.slice(0, idx) : linha);
            if (!alvos.includes(nomeLinha)) continue;

            const mesmaLinha = idx >= 0 ? linha.slice(idx + 1).trim() : '';
            if (mesmaLinha) {
                achados.push({ valor: mesmaLinha, indice: i });
            } else if (linhas[i + 1] && !linhas[i + 1].endsWith(':')) {
                achados.push({ valor: linhas[i + 1], indice: i });
            }
        }
        return achados;
    }

    function acharPorRotulo(linhas, rotulos) {
        return acharTodosPorRotulo(linhas, rotulos)[0] || null;
    }

    // Seletores da estrutura antiga (Tatelecom). Só é usado se a leitura por rótulos não achar nada.
    function extrairHistoricoLegado() {
        const d = {};
        const nomeEl = document.querySelector('.d-flex.flex-column .w-100 strong');
        if (nomeEl) d.nome = nomeEl.textContent.trim();

        const cols = Array.from(document.querySelectorAll('.row .col strong')).map(e => e.textContent.trim());
        if (cols.length >= 2) { d.cpf = cols[0]; d.nascimento = cols[1]; }
        if (cols.length >= 4) d.email = cols[2];
        if (cols.length >= 6) d.telefone = cols[4];
        if (cols.length >= 8) d.plano = cols[6];
        if (cols.length >= 10) d.iccid = cols[8];
        if (cols.length >= 12) d.status = cols[10];

        const secao = document.querySelector('.card .card-body .col-9');
        if (secao) {
            const text = secao.textContent;
            const dataMatch = text.match(/Data Prevista:\s*([^\n]+)/);
            const numeroMatch = text.match(/Número Portado:\s*([^\n]+)/);
            const statusMatch = text.match(/Status:\s*([^\n]+)/);
            if (dataMatch) d.dataPortabilidade = dataMatch[1].trim();
            if (numeroMatch) d.numeroPortado = numeroMatch[1].trim();
            if (statusMatch) d.statusPortabilidade = statusMatch[1].trim();
        }
        return d;
    }

    function extrairDadosHistorico() {
        try {
            const dados = {
                nome: '', cpf: '', nascimento: '', email: '', telefone: '', iccid: '',
                plano: '', status: '', dataPortabilidade: '', numeroPortado: '', statusPortabilidade: ''
            };

            const linhas = linhasDaPagina();
            const indices = {};

            // 1) Leitura por rótulos: não depende da estrutura HTML
            for (const campo of Object.keys(ROTULOS)) {
                if (campo === 'statusPortabilidade') continue;
                const achado = acharPorRotulo(linhas, ROTULOS[campo]);
                if (achado) {
                    dados[campo] = achado.valor;
                    indices[campo] = achado.indice;
                }
            }

            // "Status" aparece mais de uma vez: pega o que está mais perto de "Data Prevista"/"Número Portado"
            const ancora = indices.dataPortabilidade !== undefined ? indices.dataPortabilidade : indices.numeroPortado;
            if (ancora !== undefined) {
                const todos = acharTodosPorRotulo(linhas, ROTULOS.statusPortabilidade);
                if (todos.length) {
                    dados.statusPortabilidade = todos.reduce((a, b) =>
                        Math.abs(b.indice - ancora) < Math.abs(a.indice - ancora) ? b : a).valor;
                }
            }

            // 2) Fallback: seletores da estrutura antiga
            if (!dados.telefone && !dados.iccid && !dados.numeroPortado && !dados.dataPortabilidade) {
                const legado = extrairHistoricoLegado();
                Object.keys(legado).forEach(k => { if (legado[k] && !dados[k]) dados[k] = legado[k]; });
            }

            log('Dados do histórico capturados!', 'success');
            return dados;
        } catch (error) {
            console.error('Erro ao extrair dados do histórico:', error);
            log('Erro ao extrair dados do histórico', 'error');
            return null;
        }
    }

