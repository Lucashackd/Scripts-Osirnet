    function isPaginaPortabilidade() {
        if (!isTatelecom) return false;
        if (/historico-consumo|portabilidade/i.test(window.location.pathname)) return true;
        const linhas = linhasDaPagina();
        return !!(acharPorRotulo(linhas, ROTULOS.dataPortabilidade) ||
                  acharPorRotulo(linhas, ROTULOS.numeroPortado));
    }

